{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "request": "launch",
            "name": "Delivery System - Desktop",
            "mainClass": "Main",
            "cwd": "${workspaceFolder}",
            "args": ["--data-dir", "data/debug-desktop"],
            "console": "integratedTerminal"
        },
        {
            "type": "java",
            "request": "launch",
            "name": "Delivery System - CLI",
            "mainClass": "Main",
            "cwd": "${workspaceFolder}",
            "args": ["--cli", "--data-dir", "data/debug-cli"],
            "console": "integratedTerminal"
        }
    ]
}
